<?xml version="1.0" encoding="utf-8"?>
<!-- Bambuddy is served over plain HTTP on the home LAN / inside the encrypted Tailscale tunnel. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
